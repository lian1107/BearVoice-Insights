POSTGRES_DB=bearvoice
POSTGRES_USER=bearvoice
POSTGRES_PASSWORD=local-only-change-me
BEARVOICE_DATABASE_URL=postgresql+asyncpg://bearvoice:local-only-change-me@db:5432/bearvoice
BEARVOICE_TEMPORAL_ADDRESS=temporal:7233
BEARVOICE_CACHE_URL=redis://cache:6379/0
BEARVOICE_MODEL_EGRESS_ENABLED=false
BEARVOICE_MODEL_PROVIDER_ALLOWLIST=[]
BEARVOICE_MODEL_PURPOSE_ALLOWLIST=[]
BEARVOICE_MODEL_ENDPOINT_ALLOWLIST=[]
BEARVOICE_MODEL_REQUEST_TIMEOUT_SECONDS=45
BEARVOICE_SEMANTIC_BATCH_SIZE=20
BEARVOICE_SEMANTIC_MAX_CONCURRENCY=4
BEARVOICE_SEMANTIC_RETRY_MAX_ATTEMPTS=3
BEARVOICE_SEMANTIC_RETRY_INITIAL_SECONDS=1
BEARVOICE_MODEL_JOB_MAX_CALLS=500
BEARVOICE_MODEL_DAILY_MAX_CALLS=5000
BEARVOICE_MODEL_JOB_BUDGET_RMB=50
BEARVOICE_MODEL_DAILY_BUDGET_RMB=500
# 管理员用于硬预算预留的保守单次估值；预留调用数包含有界重试额度，不代表供应商最终账单。
BEARVOICE_MODEL_RESERVED_COST_PER_CALL_RMB=0.05
BEARVOICE_DEEPSEEK_API_KEY=
BEARVOICE_DEEPSEEK_BASE_URL=https://api.deepseek.com
BEARVOICE_DEEPSEEK_MODEL=deepseek-v4-pro
BEARVOICE_GLM_API_KEY=
BEARVOICE_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BEARVOICE_GLM_MODEL=glm-5.2
BEARVOICE_MINIMAX_API_KEY=
BEARVOICE_MINIMAX_BASE_URL=https://api.minimaxi.com/v1
BEARVOICE_MINIMAX_MODEL=MiniMax-M3
BEARVOICE_QWEN_API_KEY=
BEARVOICE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BEARVOICE_QWEN_MODEL=qwen3.8-max
BEARVOICE_CUSTOM_AI_API_KEY=
BEARVOICE_CUSTOM_AI_BASE_URL=
BEARVOICE_CUSTOM_AI_MODEL=
BEARVOICE_RUNTIME_ENVIRONMENT=development
BEARVOICE_LOCAL_DEV_SESSION_ENABLED=true
BEARVOICE_LOCAL_DEV_SESSION_TTL_SECONDS=3600
BEARVOICE_MAX_UPLOAD_BYTES=10485760
BEARVOICE_STORAGE_BACKEND=filesystem
